{
  "name": "TripMesh Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "astro-build.astro-vscode",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "forwardPorts": [4321, 8000, 8001, 8002, 8003, 8004, 8005],
  "portsAttributes": {
    "4321": {
      "label": "TripMesh Frontend UI",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "TripMesh Gateway API"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && cd frontend && npm install",
  "postStartCommand": "python run_mesh.py"
}
