# =============================================================================
# TripMesh — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored. Never commit secrets.
#
# Legend:
#   [REQUIRED]          The system won't start without this.
#   [OPTIONAL]          Falls back to mock/free alternative when unset.
#   [OPTIONAL-REGIONAL] Enables a region-specific transport adapter when set;
#                       the mock adapter fires instead if unset.
#   [LOCAL-DEV]         Only needed if you switch away from the default local setup.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM providers  (pick one or more; Ollama is the default for local dev)
# -----------------------------------------------------------------------------

# [OPTIONAL] Google Gemini API key — primary cloud LLM for reasoning & generation.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# [OPTIONAL] Anthropic API key — used for quality passes / production runs.
#            If unset, the system falls back to Ollama.
ANTHROPIC_API_KEY=

# [OPTIONAL] OpenAI API key — alternative cloud LLM. Same fallback as above.
OPENAI_API_KEY=

# [OPTIONAL] Ollama host. Defaults to http://localhost:11434 when unset.
#            Set this if Ollama is running on a remote machine or non-default port.
OLLAMA_BASE_URL=http://localhost:11434

# [OPTIONAL] Which Ollama model to use for local dev. Defaults to llama3.1.
OLLAMA_MODEL=llama3.1


# -----------------------------------------------------------------------------
# Hotel / Accommodation providers
# -----------------------------------------------------------------------------

# [OPTIONAL] Hotelbeds APItude credentials — covers hotel availability search.
#            If unset, the mock adapter is used and results are flagged as
#            "estimated" to the user.
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com/hotel-api/1.0


# -----------------------------------------------------------------------------
# Transport providers
# -----------------------------------------------------------------------------

# [OPTIONAL] Duffel API token — covers flight search.
#            If unset, the mock adapter is used and results are flagged as
#            "estimated" to the user.
#            If token starts with "duffel_test_", data is flagged as "estimated"
#            because sandbox API returns simulated data.
DUFFEL_ACCESS_TOKEN=

# [OPTIONAL] Amadeus Self-Service API credentials — covers flight search.
#            If unset, falls back to Duffel or mock adapter.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# [OPTIONAL-REGIONAL] Deutsche Bahn (DB) API key — train adapter for DE/EU routes.
#                     Without this, DB adapter is disabled; mock covers the route.
#                     Sign up: https://developers.deutschebahn.com/
DB_API_KEY=
DB_API_SECRET=

# [OPTIONAL-REGIONAL] National Rail Darwin API token — train adapter for UK routes.
#                     Without this, National Rail adapter is disabled; mock covers.
#                     Apply: https://www.nationalrail.co.uk/developers/
NATIONAL_RAIL_API_KEY=

# [OPTIONAL-REGIONAL] GTFS feed URL(s) — bus / regional rail adapter.
#                     Comma-separated URLs pointing to GTFS static feed zip files.
#                     Example: https://transitfeeds.com/p/my-agency/gtfs.zip
#                     Leave blank to disable the GTFS bus adapter (mock fires instead).
GTFS_FEED_URLS=

# [OPTIONAL-REGIONAL] GTFS Realtime feed URL(s) — comma-separated protobuf endpoints.
#                     Only relevant if you also set GTFS_FEED_URLS.
GTFS_RT_FEED_URLS=


# -----------------------------------------------------------------------------
# Free / keyless external APIs  (no key needed — these always work)
# -----------------------------------------------------------------------------

# Open-Meteo weather API. No key required; endpoint is hardcoded in the agent.
# Leave this blank unless you're overriding to a self-hosted instance.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Frankfurter currency API. Free, no key. Override only for self-hosted.
FRANKFURTER_BASE_URL=https://api.frankfurter.app

# OSM Nominatim geocoding. Free, no key. Override to use a private instance.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org


# -----------------------------------------------------------------------------
# Vector store / RAG  (Chroma — embedded, no server for dev)
# -----------------------------------------------------------------------------

# [OPTIONAL] Path for Chroma's persistent storage directory.
#            Defaults to ./local_guide_agent_rag/data/chroma_db if unset.
CHROMA_PERSIST_DIR=./local_guide_agent_rag/data/chroma_db

# [OPTIONAL] Chroma collection name for the Local Guide RAG corpus.
CHROMA_COLLECTION_NAME=tripmesh_local_guide


# -----------------------------------------------------------------------------
# Embeddings  (sentence-transformers — local, no API key)
# -----------------------------------------------------------------------------

# [OPTIONAL] HuggingFace model name for local embeddings.
#            Defaults to BAAI/bge-small-en-v1.5 (fast, high quality, free).
#            Alternatives: intfloat/e5-small-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5


# -----------------------------------------------------------------------------
# Observability  (Langfuse — self-hosted, free)
# -----------------------------------------------------------------------------

# [OPTIONAL] Langfuse public/secret keys — for tracing all agent calls.
#            Leave blank to disable tracing (dev default).
#            Self-host docs: https://langfuse.com/docs/deployment/self-host
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000


# -----------------------------------------------------------------------------
# Service ports  (used by docker-compose.yml)
# -----------------------------------------------------------------------------

GATEWAY_PORT=8000
PLANNER_AGENT_PORT=8001
TRANSPORT_AGENT_PORT=8002
HOTEL_AGENT_PORT=8003
LOCAL_GUIDE_AGENT_PORT=8004
BUDGET_AGENT_PORT=8005


# -----------------------------------------------------------------------------
# General / session settings
# -----------------------------------------------------------------------------

# [OPTIONAL] Log level for all services. One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# [OPTIONAL] Path to SQLite memory database for cross-session preferences and chat history.
#            Defaults to ./shared/data/tripmesh_memory.db if unset.
TRIPMESH_DB_PATH=./shared/data/tripmesh_memory.db

# [OPTIONAL] Use in-memory Chroma database instead of persistent disk.
#            Defaults to false.
CHROMA_USE_MEMORY=false

# [OPTIONAL] Default lead days for departure when only duration/dates are unspecified.
#            Defaults to 14.
DEFAULT_TRIP_LEAD_DAYS=14

# [OPTIONAL] Secret for session token signing (can be any long random string).
#            Only needed when auth is added in a later phase.
SESSION_SECRET=change-me-before-production

# -----------------------------------------------------------------------------
# Web Search & Real-Time Intelligence (Tavily)
# -----------------------------------------------------------------------------
# [OPTIONAL] Tavily API key for live web search (road conditions, destination news,
#            and local guide web search fallback for uncovered cities).
#            Get 1,000 free credits/month at https://tavily.com (no card).
#            If unset, features degrade gracefully with honest notices and never crash.
TAVILY_API_KEY=
