---
// RecommendedDestinations.astro - Cinematic destination recommendation cards
interface Destination {
  city: string;
  country: string;
  tagline: string;
  match: number;
  startingPrice: string;
  imageUrl: string;
  samplePrompt: string;
}

const destinations: Destination[] = [
  {
    city: "Tokyo",
    country: "Japan",
    tagline: "Neon skylines, high-speed rail & timeless shrines",
    match: 98,
    startingPrice: "$1,250",
    imageUrl: "https://images.unsplash.com/photo-1503899036084-c55cdd92da26?auto=format&fit=crop&w=800&q=80",
    samplePrompt: "Plan a 5 day trip to Tokyo with a budget of $1500 focusing on technology, street food, and historic shrines"
  },
  {
    city: "Rome",
    country: "Italy",
    tagline: "Living antiquities, sunset piazzas & culinary soul",
    match: 94,
    startingPrice: "$890",
    imageUrl: "https://images.unsplash.com/photo-1552832230-c0197dd311b5?auto=format&fit=crop&w=800&q=80",
    samplePrompt: "Plan a trip to Rome for 4 days with good food, boutique hotels, and historic walks"
  },
  {
    city: "Bali",
    country: "Indonesia",
    tagline: "Lush jungle villas, coastal calm & sacred water temples",
    match: 96,
    startingPrice: "$720",
    imageUrl: "https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=800&q=80",
    samplePrompt: "Plan a honeymoon escape to Bali for 6 days with luxury villas and scenic nature"
  },
  {
    city: "Reykjavik",
    country: "Iceland",
    tagline: "Glacial lagoons, geothermal springs & auroral night skies",
    match: 91,
    startingPrice: "$1,450",
    imageUrl: "https://images.unsplash.com/photo-1504893524553-b855bce32c67?auto=format&fit=crop&w=800&q=80",
    samplePrompt: "Plan a 4 day northern lights adventure in Reykjavik with geothermal hot springs"
  }
];
---

<section id="destinations" class="relative z-10 py-16 max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-10">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
    <div>
      <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-[#16E6F5] mb-2 font-semibold">
        <span>◎</span>
        <span>Curated Global Coordinates</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-sans font-bold text-white tracking-tight">
        Recommended for you
      </h2>
    </div>
    <p class="text-sm text-[#91A1B3] max-w-md">
      Synthesized from your travel affinities, seasonal weather patterns, and real-time flight inventory.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {destinations.map((dest) => (
      <div 
        class="group relative rounded-2xl overflow-hidden glass-panel glass-panel-hover border border-white/[0.08] cursor-pointer flex flex-col h-[420px] transition-all duration-300"
        onclick={`window.dispatchEvent(new CustomEvent('tripmesh:set-prompt', { detail: { prompt: "${dest.samplePrompt}" } })); document.getElementById('planner')?.scrollIntoView({ behavior: 'smooth' });`}
      >
        <!-- Background Image with Zoom on Hover -->
        <div class="absolute inset-0 z-0 overflow-hidden">
          <img 
            src={dest.imageUrl} 
            alt={`${dest.city}, ${dest.country}`}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 opacity-70"
          />
          <!-- Multi-stop Dark Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#070B12] via-[#070B12]/60 to-transparent"></div>
          <div class="absolute inset-0 bg-[#070B12]/20 group-hover:bg-transparent transition-colors duration-300"></div>
        </div>

        <!-- Top Badges -->
        <div class="relative z-10 p-5 flex justify-between items-start">
          <span class="font-mono text-[10px] tracking-wider uppercase font-bold px-2.5 py-1 rounded-full bg-[#070B12]/80 backdrop-blur-md border border-[#16E6F5]/40 text-[#16E6F5] shadow-xs">
            {dest.match}% MATCH
          </span>
          <span class="font-mono text-[11px] text-[#F3F7FA] px-2.5 py-1 rounded-full bg-white/[0.1] backdrop-blur-md border border-white/10 font-medium">
            From {dest.startingPrice}
          </span>
        </div>

        <!-- Bottom Content -->
        <div class="relative z-10 mt-auto p-6 flex flex-col justify-end space-y-2">
          <span class="font-mono text-[11px] uppercase tracking-widest text-[#91A1B3]">
            {dest.country}
          </span>
          <h3 class="text-2xl font-bold text-white tracking-tight group-hover:text-[#16E6F5] transition-colors">
            {dest.city}
          </h3>
          <p class="text-xs text-[#F3F7FA]/80 line-clamp-2 leading-relaxed">
            {dest.tagline}
          </p>

          <div class="pt-3 flex items-center gap-2 text-xs font-mono text-[#16E6F5] group-hover:translate-x-1 transition-transform duration-200">
            <span>Build with Concierge</span>
            <span>→</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
